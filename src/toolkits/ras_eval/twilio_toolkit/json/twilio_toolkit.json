                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Filter by recipient phone number"
                    },
                    "datetime_range": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Time range filter as [start, end] in YYYY-MM-DD HH:MM:SS format or comma-separated string"
                    },
                    "keywords": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Filter by keywords in message content, comma-separated for multiple keywords"
                    },
                    "max_results": {
                        "default": 10,
                        "description": "Maximum number of results to return",
                        "type": "integer"
                    }
                },
                "type": "object"
            }
        }
    },
