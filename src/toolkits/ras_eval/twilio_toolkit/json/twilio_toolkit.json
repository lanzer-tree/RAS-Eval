[
    {
        "type": "function",
        "function": {
            "name": "SendSms",
            "description": "Send SMS message to one or more phone numbers.",
            "parameters": {
                "properties": {
                    "to_phone_numbers": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            }
                        ],
                        "description": "Phone number(s) to send SMS to, can be a single number string, comma-separated string, or list of strings"
                    },
                    "message": {
                        "description": "The SMS message content to send",
                        "type": "string"
                    },
                    "scheduled_time": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "When to send the SMS in YYYY-MM-DD HH:MM:SS format"
                    },
                    "is_recurring": {
                        "default": false,
                        "description": "Whether the SMS should be sent recurrently",
                        "type": "boolean"
                    },
                    "recurrence": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Recurrence pattern when is_recurring is True"
                    }
                },
                "required": [
                    "to_phone_numbers",
                    "message"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "GetSmsHistory",
            "description": "Retrieve SMS sending history with optional filters.",
            "parameters": {
                "properties": {
