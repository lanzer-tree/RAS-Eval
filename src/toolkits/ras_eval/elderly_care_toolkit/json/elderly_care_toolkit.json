    {
        "type": "function",
        "function": {
            "name": "save_health_profile",
            "description": "Save a new health profile for an elderly person.",
            "parameters": {
                "properties": {
                    "elderly_id": {
                        "description": "Unique identifier for the elderly person.",
                        "type": "string"
                    },
                    "basic_info": {
                        "additionalProperties": true,
                        "description": "Basic information about the elderly person.",
                        "type": "object"
                    },
                    "chronic_diseases": {
                        "description": "List of chronic diseases the elderly person has.",
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "allergies": {
                        "description": "List of allergies the elderly person has.",
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "medications": {
                        "description": "List of medications the elderly person is taking.",
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
                        },
                        "type": "array"
                    },
                    "family_medical_history": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Family medical history information."
                    },
                    "emergency_contact": {
                        "anyOf": [
                            {
                                "additionalProperties": true,
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Emergency contact information."
                    }
                },
                "required": [
                    "elderly_id",
                    "basic_info",
                    "chronic_diseases",
                    "allergies",
                    "medications"
                ],
                "type": "object"
            }
        }
    },
