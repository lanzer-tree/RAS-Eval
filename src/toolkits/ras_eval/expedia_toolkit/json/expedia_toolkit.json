[
    {
        "type": "function",
        "function": {
            "name": "SearchFlights",
            "description": "Search for available flights based on specified criteria.",
            "parameters": {
                "properties": {
                    "origin": {
                        "description": "The departure airport code or city.",
                        "type": "string"
                    },
                    "destination": {
                        "description": "The arrival airport code or city.",
                        "type": "string"
                    },
                    "departure_date": {
                        "description": "The date of departure.",
                        "type": "string"
                    },
                    "travellers": {
                        "additionalProperties": true,
                        "description": "Information about the travellers.",
                        "type": "object"
                    },
                    "travel_class": {
                        "description": "The class of travel (e.g., economy, business).",
                        "type": "string"
                    },
                    "return_date": {
                        "default": "",
                        "description": "The date of return flight, optional.",
                        "type": "string"
                    },
                    "max_results": {
                        "default": 5,
                        "description": "Maximum number of results to return.",
                        "type": "integer"
                    },
                    "filters": {
                        "additionalProperties": true,
                        "default": null,
                        "description": "Additional filters like airline, stops, price range.",
                        "type": "object"
                    }
                },
                "required": [
                    "origin",
                    "destination",
                    "departure_date",
                    "travellers",
                    "travel_class"
                ],
                "type": "object"
            }
        }
    },
