[
    {
        "type": "function",
        "function": {
            "name": "WriteDiary",
            "description": "\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u65e5\u8bb0\u4e3b\u9898\u6216\u6458\u8981\uff0c\u4f7f\u7528LLM\u751f\u6210\u4e00\u7bc7\u7b26\u5408\u65e5\u5e38\u98ce\u683c\u7684\u65e5\u8bb0\u5185\u5bb9\u3002",
            "parameters": {
                "properties": {
                    "theme_or_summary": {
                        "description": "\u7528\u6237\u63d0\u4f9b\u7684\u65e5\u8bb0\u4e3b\u9898\u6216\u6458\u8981\u3002",
                        "type": "string"
                    },
                    "tone": {
                        "default": "\u4eb2\u5207",
                        "description": "\u65e5\u8bb0\u7684\u8bed\u6c14\u98ce\u683c\uff0c\u9ed8\u8ba4\"\u4eb2\u5207\"\u3002",
                        "type": "string"
                    },
                    "word_count": {
                        "default": 300,
                        "description": "\u65e5\u8bb0\u7684\u5927\u81f4\u5b57\u6570\u8981\u6c42\uff0c\u9ed8\u8ba4300\u3002",
                        "type": "integer"
                    }
                },
                "required": [
                    "theme_or_summary"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "SearchDiary",
            "description": "\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u5173\u952e\u8bcd\uff0c\u68c0\u7d22\u5339\u914d\u7684\u65e5\u8bb0\u5185\u5bb9\u3002",
            "parameters": {
                "properties": {
                    "keywords": {
                        "description": "\u7528\u4e8e\u68c0\u7d22\u7684\u5173\u952e\u8bcd\u6570\u7ec4\u3002",
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "match_type": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": "\u6a21\u7cca\u5339\u914d",
                        "description": "\u5339\u914d\u7c7b\u578b\uff0c\u9ed8\u8ba4\"\u6a21\u7cca\u5339\u914d\"\u3002"
                    }
                },
                "required": [
                    "keywords"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "DeleteDiary",
            "description": "\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u5173\u952e\u8bcd\u6216\u65e5\u8bb0id\uff0c\u5220\u9664\u6307\u5b9a\u7684\u65e5\u8bb0\u3002",
            "parameters": {
                "properties": {
                    "delete_condition": {
                        "anyOf": [
                            {
                                "additionalProperties": true,
                                "type": "object"
                            },
                            {
                                "type": "string"
                            }
                        ],
                        "description": "\u5220\u9664\u6761\u4ef6\u3002"
                    },
                    "confirm_delete": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": false,
                        "description": "\u662f\u5426\u786e\u8ba4\u5220\u9664\uff0c\u9ed8\u8ba4False\u3002"
                    }
                },
                "required": [
                    "delete_condition"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "UpdateDiary",
            "description": "\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u65e5\u8bb0id\u548c\u66f4\u65b0\u5185\u5bb9\uff0c\u4fee\u6539\u6307\u5b9a\u7684\u65e5\u8bb0\u3002",
            "parameters": {
                "properties": {
                    "diary_id": {
                        "description": "\u65e5\u8bb0ID\u3002",
                        "type": "string"
                    },
                    "update_content": {
                        "additionalProperties": true,
                        "description": "\u66f4\u65b0\u5185\u5bb9\u3002",
                        "type": "object"
                    },
                    "update_time": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": true,
                        "description": "\u662f\u5426\u66f4\u65b0\u65f6\u95f4\uff0c\u9ed8\u8ba4True\u3002"
                    }
                },
                "required": [
                    "diary_id",
                    "update_content"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "ImportDiaryFromTxt",
            "description": "\u4ece\u7528\u6237\u6307\u5b9a\u7684\u6587\u4ef6\u5730\u5740\u5bfc\u5165txt\u683c\u5f0f\u7684\u65e5\u8bb0\u6570\u636e\u3002",
            "parameters": {
                "properties": {
                    "file_path": {
                        "description": "\u6587\u4ef6\u8def\u5f84\u3002",
                        "type": "string"
                    },
                    "batch_import": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": true,
                        "description": "\u662f\u5426\u6279\u91cf\u5bfc\u5165\uff0c\u9ed8\u8ba4True\u3002"
                    }
                },
                "required": [
                    "file_path"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "ExportDiaryToTxt",
            "description": "\u5c06\u6307\u5b9a\u7684\u65e5\u8bb0\u5bfc\u51fa\u4e3atxt\u683c\u5f0f\u6587\u4ef6\u5e76\u4fdd\u5b58\u5230\u7528\u6237\u6307\u5b9a\u7684\u5730\u5740\u3002",
            "parameters": {
                "properties": {
                    "export_conditions": {
                        "additionalProperties": true,
                        "description": "\u5bfc\u51fa\u6761\u4ef6\u3002",
                        "type": "object"
                    },
                    "save_path": {
                        "description": "\u4fdd\u5b58\u8def\u5f84\u3002",
                        "type": "string"
                    },
                    "file_encoding": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": "UTF-8",
                        "description": "\u6587\u4ef6\u7f16\u7801\uff0c\u9ed8\u8ba4UTF-8\u3002"
                    }
                },
                "required": [
                    "export_conditions",
                    "save_path"
                ],
                "type": "object"
            }
        }
    }
]