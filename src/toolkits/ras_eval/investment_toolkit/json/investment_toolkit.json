                        "default": 10,
                        "description": "Maximum number of transactions to return."
                    }
                },
                "required": [
                    "account"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "search_investments",
            "description": "Search the available investment options based on keyword and investment type.",
            "parameters": {
                "properties": {
                    "query": {
                        "description": "Keyword to match against investment names and descriptions.",
                        "type": "string"
                    },
                    "type": {
                        "description": "The investment type to filter on (mutual_fund, ETF, or GIC).",
                        "type": "string"
                    },
                    "max_results": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": 5,
                        "description": "Maximum number of results to return."
                    }
                },
                "required": [
                    "query",
                    "type"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
