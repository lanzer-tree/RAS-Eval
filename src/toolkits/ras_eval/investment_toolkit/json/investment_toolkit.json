            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "list_transactions",
            "description": "List the transactions for an account filtered by date range and result count.",
            "parameters": {
                "properties": {
                    "account": {
                        "description": "Account type to look up.",
                        "type": "string"
                    },
                    "start_date": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Start of the search window (yyyy-mm-dd)."
                    },
                    "end_date": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
