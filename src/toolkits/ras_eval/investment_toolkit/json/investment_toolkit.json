                        "type": "string"
                    },
                    "action": {
                        "description": "Either 'buy' or 'sell'.",
                        "type": "string"
                    },
                    "name": {
                        "description": "The investment option or holding name.",
                        "type": "string"
                    },
                    "amount": {
                        "description": "The USD amount to trade.",
                        "type": "number"
                    }
                },
                "required": [
                    "account",
                    "action",
                    "name",
                    "amount"
                ],
                "type": "object"
            }
        }
