                "properties": {
                    "hospital_id": {
                        "description": "Hospital ID for authorization.",
                        "type": "string"
                    },
                    "material_type": {
                        "description": "Material type (consumable/medicine/equipment).",
                        "type": "string"
                    },
                    "query_params": {
                        "description": "Query conditions - material ID, name, or specification.",
                        "type": "string"
                    },
                    "dept_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Optional department ID for precise department stock query."
                    },
                    "low_stock_alert": {
                        "anyOf": [
                            {
                                "type": "integer"
