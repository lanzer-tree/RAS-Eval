[
    {
        "type": "function",
        "function": {
            "name": "search_design_templates",
            "description": "Search and filter design templates from the template library.",
            "parameters": {
                "properties": {
                    "user_id": {
                        "description": "The unique identifier of the user.",
                        "type": "string"
                    },
                    "design_type": {
                        "description": "The type of design to search for. Valid values: 'poster', 'document', 'ppt', 'social_media'.",
                        "type": "string"
                    },
                    "style": {
                        "default": null,
                        "description": "Style filter. Valid values: 'minimal', 'business', 'cute', 'modern', 'vintage'.",
                        "type": "string"
                    },
                    "dimension": {
                        "default": null,
                        "description": "Dimension filter. Valid values: 'A4', '9:16', '16:9', '1:1', 'custom'.",
                        "type": "string"
                    },
                    "tags": {
                        "default": null,
                        "description": "Keywords to filter templates by.",
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    }
                },
                "required": [
                    "user_id",
                    "design_type"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "init_design_project",
            "description": "Initialize a new design project based on a template or as a blank canvas.",
            "parameters": {
                "properties": {
                    "user_id": {
                        "description": "The unique identifier of the user.",
                        "type": "string"
                    },
                    "project_name": {
                        "description": "The name of the new project.",
                        "type": "string"
                    },
                    "template_id": {
                        "default": null,
                        "description": "Template ID to base the project on. Leave empty for blank design.",
                        "type": "string"
                    },
                    "custom_dimension": {
                        "default": null,
                        "description": "Custom dimension for blank design (e.g., '1920x1080'). Required if template_id is not provided.",
                        "type": "string"
                    },
                    "design_category": {
                        "default": null,
                        "description": "Category label for the project.",
                        "type": "string"
                    }
                },
                "required": [
                    "user_id",
                    "project_name"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "fetch_design_assets",
            "description": "Fetch design assets from the asset library (images, icons, fonts, shapes).",
            "parameters": {
                "properties": {
                    "user_id": {
                        "description": "The unique identifier of the user.",
                        "type": "string"
                    },
                    "asset_type": {
                        "description": "The type of asset to fetch. Valid values: 'image', 'icon', 'font', 'shape'.",
                        "type": "string"
                    },
                    "keyword": {
                        "default": null,
                        "description": "Search keyword to filter assets.",
                        "type": "string"
                    },
                    "style_filter": {
                        "default": null,
                        "description": "Style filter for assets (e.g., 'minimal', 'colorful').",
                        "type": "string"
                    },
                    "license_type": {
                        "default": null,
                        "description": "License type filter. Valid values: 'free', 'commercial'.",
                        "type": "string"
                    }
                },
                "required": [
                    "user_id",
                    "asset_type"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "edit_design_elements",
            "description": "Edit design elements in a project (add, modify, or delete text, images, shapes).",
            "parameters": {
                "properties": {
                    "user_id": {
                        "description": "The unique identifier of the user.",
                        "type": "string"
                    },
                    "project_id": {
                        "description": "The unique identifier of the project.",
                        "type": "string"
                    },
                    "element_operations": {
                        "description": "List of operations to perform. Each operation should have: 'action' ('add', 'modify', or 'delete'), 'element_type' ('text', 'image', or 'shape', required for 'add'), 'element_id' (ID of element, required for 'modify' and 'delete'), 'properties' (Dict of properties to set, for 'add' and 'modify')",
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
                        },
                        "type": "array"
                    },
                    "element_params": {
                        "additionalProperties": true,
                        "default": null,
                        "description": "Additional parameters like position, size, color, font.",
                        "type": "object"
                    }
                },
                "required": [
                    "user_id",
                    "project_id",
                    "element_operations"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "batch_generate_designs",
            "description": "Batch generate design outputs by replacing elements with batch data.",
            "parameters": {
                "properties": {
                    "user_id": {
                        "description": "The unique identifier of the user.",
                        "type": "string"
                    },
                    "project_id": {
                        "description": "The base project ID to use as template.",
                        "type": "string"
                    },
                    "batch_data": {
                        "description": "List of data for batch generation. Each item should contain element replacements like {'text_1': 'New Text', 'image_1': 'url'}.",
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
                        },
                        "type": "array"
                    },
                    "output_format": {
                        "default": "PNG",
                        "description": "Output format. Valid values: 'PNG', 'JPG', 'PDF'. Default is 'PNG'.",
                        "type": "string"
                    },
                    "naming_rule": {
                        "default": null,
                        "description": "Naming rule for output files (e.g., 'design_{index}').",
                        "type": "string"
                    }
                },
                "required": [
                    "user_id",
                    "project_id",
                    "batch_data"
                ],
                "type": "object"
            }
        }
    },
    {
