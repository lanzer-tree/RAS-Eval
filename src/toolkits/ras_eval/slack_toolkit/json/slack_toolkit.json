    {
        "type": "function",
        "function": {
            "name": "search_message",
            "description": "Search for messages in a channel or direct messages.",
            "parameters": {
                "properties": {
                    "query": {
                        "description": "The search query.",
                        "type": "string"
                    },
                    "to": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "The receive of messages."
                    },
                    "source": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "The sender of messages."
                    },
                    "max_results": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": 10,
                        "description": "The number of maximum results."
                    }
                },
                "required": [
                    "query"
                ],
                "type": "object"
            }
        }
    },
    {
        "type": "function",
        "function": {
            "name": "search_channel_or_user",
            "description": "Search for channels or users by query.",
            "parameters": {
                "properties": {
                    "query": {
                        "description": "The search query.",
                        "type": "string"
                    },
                    "search_type": {
                        "description": "One of ['channels', 'users'], the type of resources to search.",
                        "type": "string"
                    },
                    "max_results": {
                        "default": 10,
                        "description": "The maximum number of results to return. Default is 10.",
                        "type": "integer"
                    }
                },
                "required": [
                    "query",
                    "search_type"
                ],
                "type": "object"
            }
        }
    },
