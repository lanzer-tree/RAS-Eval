                    },
                    "message": {
                        "description": "The content of the message.",
                        "type": "string"
                    },
                    "file_path": {
                        "default": null,
                        "description": "The local file path of the file to upload.",
                        "type": "string"
                    }
                },
                "required": [
                    "recipient",
                    "message"
                ],
                "type": "object"
            }
        }
    },
