                "properties": {
                    "user_id": {
                        "description": "The unique identifier of the user.",
                        "type": "string"
                    },
                    "set_id": {
                        "description": "The unique identifier of the study set.",
                        "type": "string"
                    },
                    "target_days": {
                        "description": "The target number of days to complete the study set.",
                        "type": "integer"
                    },
                    "daily_amount": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "The daily learning amount. If not provided, it will be automatically calculated."
                    },
                    "recite_mode": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": "new_and_review",
                        "description": "The recitation mode: 'new_and_review' or 'new_only'. Default is 'new_and_review'."
                    }
                },
                "required": [
                    "user_id",
                    "set_id",
                    "target_days"
                ],
                "type": "object"
            }
        }
    },
