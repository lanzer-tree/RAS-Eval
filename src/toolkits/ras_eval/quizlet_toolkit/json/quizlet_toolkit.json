[
    {
        "type": "function",
        "function": {
            "name": "create_study_set",
            "description": "Create a new study set (flashcards, knowledge points, or formulas).",
            "parameters": {
                "properties": {
                    "user_id": {
                        "description": "The unique identifier of the user creating the study set.",
                        "type": "string"
                    },
                    "set_title": {
                        "description": "The title of the study set.",
                        "type": "string"
                    },
                    "study_items": {
                        "description": "A list of study items, each containing 'term' (question/term) and 'definition' (answer/definition).",
                        "items": {
                            "additionalProperties": {
                                "type": "string"
                            },
                            "type": "object"
                        },
                        "type": "array"
                    },
                    "set_type": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": "flashcard",
                        "description": "The type of study set: 'flashcard', 'knowledge', or 'formula'. Default is 'flashcard'."
                    },
                    "tags": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "A list of tags for categorization."
                    },
                    "visibility": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": "private",
                        "description": "The visibility setting: 'private', 'public', or 'group'. Default is 'private'."
                    }
                },
                "required": [
                    "user_id",
                    "set_title",
                    "study_items"
                ],
                "type": "object"
            }
        }
    },
