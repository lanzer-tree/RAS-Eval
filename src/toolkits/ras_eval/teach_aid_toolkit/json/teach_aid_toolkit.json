            "name": "manage_course",
            "description": "Create, update, or query course information.",
            "parameters": {
                "properties": {
                    "teacher_id": {
                        "description": "The unique identifier of the teacher.",
                        "type": "string"
                    },
                    "operation_type": {
                        "description": "The type of operation to perform. Must be one of 'create', 'update', or 'query'.",
                        "type": "string"
                    },
                    "course_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "The unique identifier of the course. Required for 'update' and 'query' operations."
                    },
                    "course_data": {
                        "anyOf": [
                            {
                                "additionalProperties": true,
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Course information including name, subject, hours, and objectives. Required for 'create' and 'update' operations."
                    },
                    "query_fields": {
                        "anyOf": [
                            {
                                "items": {
                                    "type": "string"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "Specific fields to return in query results."
                    }
                },
                "required": [
                    "teacher_id",
                    "operation_type"
                ],
                "type": "object"
            }
        }
    },
