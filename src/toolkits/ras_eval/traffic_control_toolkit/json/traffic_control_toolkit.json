                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "description": "The type of location to filter by ('road' or 'intersection'). Default is None to search all types."
                    }
                },
                "required": [
                    "location_name"
